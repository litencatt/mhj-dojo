# tagpr (https://github.com/Songmu/tagpr, .github/workflows/tagpr.yml): keeps a
# release pull request open on main that updates CHANGELOG.md. Merging it tags
# the release (v2026.0927.0: the date in Japan and the number of the release
# that day, from 0; three parts, as tagpr's CHANGELOG headings read only
# three) and creates the GitHub Release; tagpr.yml then runs
# build-site-release.yml, which attaches the built site to the Release and
# calls deploy-lolipop.yml to open the pull request into lolipop-deploy-now.
[tagpr]
	vPrefix = true
	releaseBranch = main
	versionFile = -
	calendarVersioning = YYYY.0M0D.MICRO
	changelog = true
	release = true
