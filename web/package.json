{
  "name": "mhj-dojo-web",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "build:site": "tsc --noEmit && vite build --mode site",
    "dev:site": "vite --mode site",
    "preview:site": "vite preview --mode site",
    "e2e:site": "playwright test -c playwright.site.config.ts",
    "e2e:live": "playwright test -c playwright.live.config.ts",
    "gen-icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
